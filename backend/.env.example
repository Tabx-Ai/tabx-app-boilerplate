# The environment this app's backend reads — the human-readable half of the three files
# that move together whenever a key is added (constitution Article VI §3): this file,
# `src/config/index.ts`'s schema, and `manifest.json`'s `env`. A test cross-checks all three,
# so an undocumented key fails the suite.
#
# Every key below is DEFAULTED in the schema, which is why a bare clone boots with no `.env`
# at all. Values reach a deployed app by injection into the Lambda's environment — never
# from a committed file. Copy this to `.env` only for local experiments; `.env` is ignored.

# The app's name, used in responses and logs. Architect's deploy sets it.
APP_NAME=boilerplate-app

# Which environment this invocation believes it is in: dev | prod.
STAGE=dev

# The platform's API base — what the `tabx/` SDK calls (constitution Article XIV). OPTIONAL:
# an app that never calls the platform leaves it unset, boots and answers normally; the SDK's
# first call is what fails, naming this variable. The deploy sets it; never commit a real one.
TABX_URL=https://tabx.example.com/api

# This app's own Postgres connection (constitution Article XV) — the platform's Session Pooler
# shape, scoped to this app's own database. OPTIONAL: every app has a schema, but not every
# clone persists anything, so leaving this unset still boots; the persistence client's first
# use is what fails, naming whichever of OLTP_URL/OLTP_SCHEMA is actually missing.
OLTP_URL=postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:5432/postgres

# This app's own schema name inside that connection — derived and injected by the platform,
# never computed here. Arrives together with OLTP_URL in practice.
OLTP_SCHEMA=app_00000000000000000000000000000000
